# ---------------------------------------------------------------
# AI Interview Copilot — environment configuration
# Copy this file to .env and fill in your values. NEVER commit .env.
# ---------------------------------------------------------------

APP_NAME="AI Interview Copilot"
# development | production
APP_ENV=development
# Public URL of the app, no trailing slash (e.g. https://example.com or http://localhost:8000)
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

DB_HOST=localhost
DB_PORT=3306
DB_NAME=interview_copilot
DB_USER=root
DB_PASS=

# ---- OpenAI (server-side only; never exposed to the browser) ----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional: OpenAI organisation / project headers
OPENAI_ORGANIZATION=
OPENAI_PROJECT=

# Model that analyses questions and writes answer guidance (fast + cheap is best)
OPENAI_ANSWER_MODEL=gpt-6-luna
# Reasoning effort for the answer model: none | low | medium | high (leave empty to omit)
OPENAI_ANSWER_REASONING=none
# Model that reads the uploaded CV and builds the compressed candidate profile
OPENAI_CV_MODEL=gpt-6-luna
OPENAI_CV_REASONING=low
# Model that reads a photographed/scanned question paper (must be vision-capable)
OPENAI_SCAN_MODEL=gpt-6-luna
OPENAI_SCAN_REASONING=low
# Output budget for the question list of one scan
OPENAI_SCAN_MAX_OUTPUT_TOKENS=4000
# Fallback (recorded audio) transcription model
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# Live (WebRTC) transcription model
OPENAI_REALTIME_TRANSCRIBE_MODEL=gpt-live-transcribe
# Enable live WebRTC transcription (falls back to recording automatically if it fails)
OPENAI_REALTIME_ENABLED=true
# Transcription language hint (ISO-639-1, e.g. en). Leave empty for auto-detect.
OPENAI_TRANSCRIBE_LANGUAGE=en
# HTTP timeouts (seconds)
OPENAI_TIMEOUT=45
OPENAI_CONNECT_TIMEOUT=10

# Optional cost estimation, USD per 1M tokens: "model:input:output,model:input:output"
OPENAI_PRICING="gpt-6-luna:0.10:0.50"

# Optional: absolute path for private files (CVs, temp audio, logs). Default: ./storage
# STORAGE_PATH=/home/youruser/icp-storage

# ---- Limits ----
MAX_CV_SIZE_MB=10
MAX_AUDIO_SIZE_MB=20
# Scanned question papers: per-page size limit, and pages per scan (1-12)
MAX_SCAN_PAGE_MB=8
MAX_SCAN_PAGES=8
# Combined size of one scan's pages (keep below post_max_size in .user.ini)
MAX_SCAN_TOTAL_MB=20
# Minutes of inactivity before a user is logged out
SESSION_TIMEOUT_MINUTES=120
# short | medium
DEFAULT_ANSWER_LENGTH=short

# ---- Mail (password reset). Uses PHP mail(). In development the reset link is also shown on screen and logged.
MAIL_ENABLED=false
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME="AI Interview Copilot"
